# Copy to .env on the deploy host. Never commit the real file.
# The public docker-compose.yml treats the passwords and SESSION_SECRET below
# as REQUIRED — `docker compose up` errors out if any is left empty.

# Datastore passwords. No defaults: pick strong random values.
#   openssl rand -hex 24
POSTGRES_PASSWORD=change-me
VALKEY_PASSWORD=change-me

# Public identity of this gateway. Must match the hostname clients use —
# it is the OAuth issuer, compared byte-for-byte against the metadata.
# Dev:  http://127.0.0.1:8400
# Prod: https://torii.example.com
PUBLIC_BASE_URL=http://127.0.0.1:8400

# Signs the UI session cookie; sessions die on restart if unset.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# On behind the tunnel (HTTPS); off for plain-HTTP LAN access.
SESSION_HTTPS_ONLY=false

# Encrypts upstream auth headers at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing this key loses those credentials and NOTHING else — re-enter them in
# /ui/admin/upstreams. After setting it, run:
#   docker compose exec torii python -m torii.cli encrypt-secrets
TORII_ENCRYPTION_KEY=

LOG_LEVEL=INFO

# Only for the `tunnel` compose profile.
TUNNEL_TOKEN=

# Prometheus scrape token. EMPTY = /metrics does not exist (404), which is the
# default: the series name every upstream including private ones, so exposure
# is opt-in. Scrape over the LAN — do NOT add /metrics to the Cloudflare
# Browser-Integrity-Check exemption list.
METRICS_TOKEN=
